<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xunwu.leida.mapper.LocationMapper">

    <select id="findAll" resultType="com.xunwu.leida.entity.Location">
        SELECT id, building, floor, parent_id, created_at
        FROM locations
        ORDER BY id
    </select>

    <select id="existsById" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM locations WHERE id = #{id})
    </select>

</mapper>
